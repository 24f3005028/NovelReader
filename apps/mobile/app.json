{
  "expo": {
    "name": "NovelReader",
    "slug": "novelreader",
    "scheme": "novelreader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.novelreader.app"
    },
    "android": {
      "package": "com.novelreader.app",
      "adaptiveIcon": {
        "backgroundColor": "#05070B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0241bf79-2284-49bb-8bdf-ed11a6c69529"
      }
    },
    "owner": "harnoorsingh1906"
  }
}
