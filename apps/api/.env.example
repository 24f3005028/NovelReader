PORT=4000
HOST=0.0.0.0
# Coolify direct reverse proxy: 1. Leave unset for direct local development.
TRUST_PROXY_HOPS=
DATABASE_PATH=./data/novelreader.db
# Enable only sources you have permission to import from.
ENABLED_SOURCES=demo,freewebnovel-net,readnovelfull
SCRAPE_DELAY_MS=1500
AUTO_INDEX_CATALOG=true
# Set both API_TOKEN and EXPO_PUBLIC_API_TOKEN before exposing the API.
API_TOKEN=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Optional public Reddit RSS feeds. No Reddit API credentials are used.
REDDIT_RSS_ENABLED=true
REDDIT_SUBREDDITS=noveltranslations,LightNovels,ProgressionFantasy
