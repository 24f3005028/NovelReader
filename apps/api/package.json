{
  "name": "@novelreader/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "scrape": "tsx --env-file-if-exists=.env src/cli.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@novelreader/shared": "1.0.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
