    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "robots-parser": "^3.0.1",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
